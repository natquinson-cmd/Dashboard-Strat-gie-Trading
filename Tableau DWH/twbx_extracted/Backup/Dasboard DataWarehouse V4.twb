            <column aggregation='User' caption='Snapshot Dernier - Flux Real' datatype='integer' default-format='n#,##0;-#,##0' default-type='quantitative' layered='true' name='[Snapshot Dernier - Cadrage Real (copie)_1256785803706753040]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
              <calculation class='tableau' formula='count(IF [DateDujour] = {MAX([DateDujour])}  and [Statut flux]= &quot;Réalisation en cours&quot;&#13;&#10;THEN([Nom rapport]+[Nom source])&#13;&#10;END)' />
