    <worksheet name='Statut Cadrage Real'>
      <table>
        <view>
          <datasources>
            <datasource caption='Perimetre_Migration (Excel)' name='sqlproxy.1yiv2z00jebo4919a1ffq12saj0f' />
          </datasources>
          <datasource-dependencies datasource='sqlproxy.1yiv2z00jebo4919a1ffq12saj0f'>
            <column aggregation='Count' caption='Statut Global' datatype='string' default-type='nominal' layered='true' name='[Calculation_1009650768493371395]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
              <calculation class='tableau' formula='IF [Statut reporting] = &quot;Terminé&quot; THEN &#13;&#10;    &quot;Terminé&quot;&#13;&#10;ELSEIF [Statut Cadrage conception] &lt;&gt; &quot;A faire&quot; THEN &#13;&#10;    &quot;En cours&quot;&#13;&#10;ELSE &#13;&#10;    &quot;A faire&quot;&#13;&#10;END' />
            </column>
            <column caption='&quot;En cours :&quot;' datatype='string' name='[Calculation_3581487648729477120]' role='dimension' type='nominal' user:unnamed='Statut Cadrage Real'>
              <calculation class='tableau' formula='&quot;En cours :&quot;' />
            </column>
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[Cibles]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='Year' caption='Date Dujour' datatype='date' default-type='ordinal' layered='true' name='[DateDujour]' pivot='key' role='dimension' type='ordinal' user-datatype='date' visual-totals='Default' />
            <column aggregation='User' caption='Delta Cadrage Real' datatype='integer' default-format='n#,##0;-#,##0' default-type='quantitative' layered='true' name='[Delta rapports terminés (copie)_1256785803699056640]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
              <calculation class='tableau' formula='ZN([Non démarré (Dernier Snapshot)  (copie)_1256785803699798024]) - &#13;&#10;ZN([Tâches Terminées (Snapshot Précédent) (copie)_1256785803701272585])' />
            </column>
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[Nom rapport]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[Nom source]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='User' caption='Snapshot Dernier - Cadrage En cours' datatype='integer' default-format='n#,##0;-#,##0' default-type='quantitative' layered='true' name='[Non démarré (Dernier Snapshot)  (copie)_1256785803699798024]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
              <calculation class='tableau' formula='count(IF [DateDujour] = {MAX([DateDujour])}  and [Statut Cadrage conception]= &quot;Analyse en cours&quot;&#13;&#10;THEN([Nom rapport]+[Nom source])&#13;&#10;END)' />
            </column>
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[Pertinence de reprise dans le cadre du projet]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[Statut Cadrage conception]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[Statut reporting]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='User' caption='Snapshot Précédent - Cadrage En cours' datatype='integer' default-format='n#,##0;-#,##0' default-type='ordinal' layered='true' name='[Tâches Terminées (Snapshot Précédent) (copie)_1256785803701272585]' pivot='key' role='measure' type='ordinal' user-datatype='integer' visual-totals='Default'>
              <calculation class='tableau' formula='count(IF [DateDujour] = { FIXED : MAX(IF [DateDujour] &lt; {MAX([DateDujour])} THEN [DateDujour] END) } and [Statut Cadrage conception]=&quot;Analyse en cours&quot;&#13;&#10;THEN [Nom rapport]+[Nom source]&#13;&#10;END)' />
