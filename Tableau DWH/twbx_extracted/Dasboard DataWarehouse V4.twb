              <calculation class='tableau' formula='IF [Statut reporting] = &quot;Terminé&quot; THEN &#13;&#10;    &quot;Terminé&quot;&#13;&#10;ELSEIF [Statut Cadrage conception] &lt;&gt; &quot;A faire&quot; THEN &#13;&#10;    &quot;En cours&quot;&#13;&#10;ELSE &#13;&#10;    &quot;A faire&quot;&#13;&#10;END' />
            </column>
            <column aggregation='Count' caption='Filtre - Date dernière extraction' datatype='boolean' default-type='nominal' layered='true' name='[Calculation_1376412664187936768]' pivot='key' role='dimension' type='nominal' user-datatype='boolean' visual-totals='Default'>
              <calculation class='tableau' formula='[DateDujour] = { FIXED : MAX([DateDujour]) }' />
            </column>
            <column aggregation='User' caption='Nb rapports total' datatype='real' datatype-customized='true' default-format='n#,##0;-#,##0' default-type='quantitative' layered='true' name='[Calculation_1824239350087143424]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='COUNT(IFNULL([Nom source], &quot;&quot;) + &quot; | &quot; + IFNULL([Nom rapport], &quot;&quot;))/2' />
            </column>
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[Cibles]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
