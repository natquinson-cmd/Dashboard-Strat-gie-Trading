          <datasource-dependencies datasource='sqlproxy.1yiv2z00jebo4919a1ffq12saj0f'>
            <column aggregation='Count' caption='Statut Global' datatype='string' default-type='nominal' layered='true' name='[Calculation_1009650768493371395]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
              <calculation class='tableau' formula='IF [Statut reporting] = &quot;Terminé&quot; THEN &#13;&#10;    &quot;Terminé&quot;&#13;&#10;ELSEIF [Statut Cadrage conception] &lt;&gt; &quot;A faire&quot; THEN &#13;&#10;    &quot;En cours&quot;&#13;&#10;ELSE &#13;&#10;    &quot;A faire&quot;&#13;&#10;END' />
