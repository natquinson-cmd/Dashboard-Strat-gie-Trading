          <calculation column='[Calculation_1912622497343381506]' formula='{FIXED : MIN([DateDujour])}' />
          <calculation column='[Calculation_2104025483336175616]' formula='IF [DateDujour] = { FIXED : MAX([DateDujour]) }&#13;&#10;AND [Date d&apos;échéance] &lt; [DateDujour]&#13;&#10;AND [Date d&apos;échéance] &gt;= DATEADD(&apos;day&apos;, -7, [DateDujour])&#13;&#10;AND [Calculation_1009650768493371395] &lt;&gt; &quot;Terminé&quot;&#13;&#10;THEN &quot;Nouveau Retard&quot;&#13;&#10;ELSE &quot;Autre&quot;&#13;&#10;END' />
          <calculation column='[Calculation_260364383038353420]' formula='AVG(0)' />
          <calculation column='[Calculation_260364383038431246]' formula='AVG(0)' />
          <calculation column='[Calculation_260364383079702545]' formula='DATEDIFF(&apos;day&apos;, [DateDujour], [Date d&apos;échéance])*-1' />
          <calculation column='[Calculation_260364383299268626]' formula='IF [DateDujour] = {MAX([DateDujour])} &#13;&#10;THEN [Nb rapports (copie)_1824239350089158657] &#13;&#10;END' />
          <calculation column='[Calculation_260364383300485140]' formula='ZN(sum([Calculation_260364383299268626])) - &#13;&#10;ZN(sum([Calculation_260364383320588309]))' />
          <calculation column='[Calculation_260364383320588309]' formula='IF [DateDujour] = { FIXED : MAX(IF [DateDujour] &lt; {MAX([DateDujour])} THEN [DateDujour] END) }&#13;&#10;THEN [Calculation_2712292900835684352]&#13;&#10;END' />
          <calculation column='[Calculation_260364383322931222]' formula='IF [Calculation_260364383300485140] &gt; 0 THEN &quot;▲&quot;&#13;&#10;END' />
          <calculation column='[Calculation_2628413362821959680]' formula='IF [Calculation_1009650768493371395] &lt;&gt; &quot;Terminé&quot; &#13;&#10;AND [Date d&apos;échéance] &lt; [DateDujour]&#13;&#10;THEN 0.5&#13;&#10;ELSE 0&#13;&#10;END' />
          <calculation column='[Calculation_2712292900835684352]' formula='IF [Statut reporting] = &quot;Terminé&quot; THEN 0.5 ELSE 0 END' />
          <calculation column='[Calculation_2841489928004562944]' formula='&quot;Tunnel de Migration&#13;&#10;Cette section mesure l&apos;entonnoir du périmètre projet, de l&apos;inventaire initial à la cible finale.&#13;&#10;&#13;&#10;Périmètre total : L&apos;inventaire complet des rapports identifiés au lancement de la migration (ex: 2 078 au total).&#13;&#10;&#13;&#10;Périmètre résiduel : Rapports dont la migration est confirmée et actuellement en cours d&apos;étude ou de traitement.&#13;&#10;&#13;&#10;Périmètre Reporting : Sous-ensemble des rapports destinés à être intégrés dans l&apos;environnement BI cible.&#13;&#10;&#13;&#10;Périmètre final : Nombre définitif de rapports qui seront maintenus en production après la bascule.&#13;&#10;&#13;&#10;📈 Avancement &amp; Statuts&#13;&#10;Indicateurs de performance temporelle et opérationnelle basés sur les snapshots de données.&#13;&#10;&#13;&#10;Statut (Cadrage, Conception, Flux, Reporting) : État d&apos;avancement par phase technique.&#13;&#10;&#13;&#10;A faire (Gris) : Tâches en attente.&#13;&#10;&#13;&#10;Analyse en cours (Orange) : Travail intellectuel ou technique entamé.&#13;&#10;&#13;&#10;Prêt pour réalisation (Jaune) : Étape validée prête pour le développement.&#13;&#10;&#13;&#10;Terminé (Vert) : Étape finalisée.&#13;&#10;&#13;&#10;Evolution S vs S-1 : Comparaison entre le snapshot actuel et le précédent.&#13;&#10;&#13;&#10;Real / Test : Indicateurs de performance réelle contre environnement de test.&#13;&#10;&#13;&#10;Calcul de Tendance : Utilise le formatage conditionnel discuté précédemment :&#13;&#10;&#13;&#10;▲ Rouge : Augmentation du volume de tâches (ou retard).&#13;&#10;&#13;&#10;▼ Vert : Diminution (progression positive).&#13;&#10;&#13;&#10;● Orange : Situation stable.&#13;&#10;&#13;&#10;⚖️ Workload &amp; Répartition&#13;&#10;Analyse de la charge de travail par flux et par intervenant.&#13;&#10;&#13;&#10;Workload par tâches (Donut Chart) : Répartition du volume de travail par code intervenant (NQU, ASA, EFR, JDF, etc.).&#13;&#10;&#13;&#10;Nexus / Plexus / Autres : Segmentation par pôles technologiques ou applicatifs du Data Warehouse.&#13;&#10;&#13;&#10;REF BI01 / REF BI02 (Champs calculés LOD) : Colonnes fixes permettant d&apos;identifier les intervenants référents sans être impactées par le pivot de données nécessaire aux graphiques de répartition.&#13;&#10;&#13;&#10;🕒 Alertes de Retard (Logique de filtre)&#13;&#10;Bien que non visible directement en texte, cette logique pilote vos indicateurs de tendance.&#13;&#10;&#13;&#10;Nouveau Retard : Tâche dont la date d&apos;échéance a été dépassée entre l&apos;avant-dernier et le dernier snapshot.&#13;&#10;&#13;&#10;Delta de Retard : Mesure mathématique (Écart = Snapshot actuel - Snapshot précédent) affichée avec les caractères spéciaux ▲/▼.&quot;' />
          <calculation column='[Delta Cadrage Real (copie)_1256785803699122177]' formula='ZN([Snapshot Dernier - Cadrage Real (copie)_1256785803705655306]) - &#13;&#10;ZN([Snapshot Précédent - Cadrage Real (copie) (copie) (copie)_1256785803705683983])' />
          <calculation column='[Delta Cadrage Real (copie)_1256785803796484136]' formula='AVG([Snapshot Précédent - Cadrage Real (copie)_1256785803798151212]) - AVG([Snapshot Dernier - Cadrage Real (copie)_1256785803797241899])' />
          <calculation column='[Delta Cadrage Test (copie)_1256785803699167234]' formula='ZN([Snapshot Dernier - Cadrage Real (copie) (copie)_1256785803705671692]) - &#13;&#10;ZN([Snapshot Précédent - Cadrage Real (copie)_1256785803705655307])' />
          <calculation column='[Delta Conception Real (copie)_1256785803699240963]' formula='ZN([Snapshot Dernier - Cadrage Real (copie) (copie) (copie)_1256785803705683982]) - &#13;&#10;ZN([Snapshot Précédent - Cadrage Real (copie) (copie)_1256785803705671693])' />
          <calculation column='[Delta Conception Test (copie)_1256785803699277828]' formula='ZN([Snapshot Dernier - Cadrage Real (copie)_1256785803706753040]) - &#13;&#10;ZN([Snapshot Précédent - Conception Real (copie)_1256785803709407253])' />
          <calculation column='[Delta Flux Real (copie)_1256785803699400709]' formula='ZN([Snapshot Dernier - Cadrage Test (copie)_1256785803706753041]) - &#13;&#10;ZN([Snapshot Précédent - Conception Test (copie) (copie)_1256785803709419543])' />
          <calculation column='[Delta Flux Test (copie) (copie)_1256785803699437575]' formula='ZN([Snapshot Dernier - Cadrage Test (copie) (copie)_1256785803706773523]) - &#13;&#10;ZN([Snapshot Précédent - Conception Test (copie)_1256785803709407252])' />
          <calculation column='[Delta Flux Test (copie)_1256785803699433478]' formula='ZN([Snapshot Dernier - Cadrage Real (copie) (copie)_1256785803706773522]) - &#13;&#10;ZN([Snapshot Précédent - Conception Real (copie) (copie)_1256785803709419542])' />
          <calculation column='[Delta rapports terminés (copie)_1256785803699056640]' formula='ZN([Non démarré (Dernier Snapshot)  (copie)_1256785803699798024]) - &#13;&#10;ZN([Tâches Terminées (Snapshot Précédent) (copie)_1256785803701272585])' />
          <calculation column='[Delta rapports terminés (copie)_1912622497346252805]' formula='(ZN([Tâches Terminées (Dernier Snapshot) (copie)_1912622497346392070]) - &#13;&#10;ZN([Non démarré (Dernier Snapshot)  (copie)_1912622497347829767]))/2' />
          <calculation column='[Delta retard moyen (copie)_1256785804433367087]' formula='AVG([Snapshot Précédent - Retard en jour (copie)_1256785804432789549]) - AVG([Snapshot Dernier - Retard en jour (copie)_1256785804432814126])' />
