  <repository-location id='Jira_Projet' path='/datasources' revision='1.3' />
  <connection channel='https' class='sqlproxy' dbname='Jira_Projet' directory='/dataserver' port='443' server='tableau.epfl.ch'>
    <relation name='sqlproxy' table='[sqlproxy]' type='table' />
    <cols>
      <map key='[Champs personnalisés (Start date)]' value='[sqlproxy].[Champs personnalisés (Start date)]' />
