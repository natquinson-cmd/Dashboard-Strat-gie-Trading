    <worksheet name='Statut Flux Real'>
      <table>
        <view>
          <datasources>
            <datasource caption='Perimetre_Migration_Hyper' name='sqlproxy.15pbedn0q6uqg31a9u9hr1vudrnj' />
          </datasources>
          <datasource-dependencies datasource='sqlproxy.15pbedn0q6uqg31a9u9hr1vudrnj'>
            <column caption='Statut Global' datatype='string' name='[Calculation_1009650768493371395]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Statut reporting] = &quot;Terminé&quot; THEN &#13;&#10;    &quot;Terminé&quot;&#13;&#10;ELSEIF [Statut Cadrage conception] &lt;&gt; &quot;A faire&quot; THEN &#13;&#10;    &quot;En cours&quot;&#13;&#10;ELSE &#13;&#10;    &quot;A faire&quot;&#13;&#10;END' />
            </column>
            <column caption='&quot;Real :&quot;' datatype='string' name='[Calculation_1256785803729948701]' role='dimension' type='nominal' user:unnamed='Statut Cadrage Evo'>
              <calculation class='tableau' formula='&quot;Real :&quot;' />
            </column>
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[Cibles]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='Year' caption='Date Dujour' datatype='date' default-type='ordinal' layered='true' name='[DateDujour]' pivot='key' role='dimension' type='ordinal' user-datatype='date' visual-totals='Default' />
            <column caption='Delta Flux Real' datatype='integer' default-format='n#,##0;-#,##0' name='[Delta Conception Test (copie)_1256785803699277828]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([Snapshot Dernier - Cadrage Real (copie)_1256785803706753040]) - &#13;&#10;ZN([Snapshot Précédent - Conception Real (copie)_1256785803709407253])' />
            </column>
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[Nom rapport]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[Nom source]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[Pertinence de reprise dans le cadre du projet]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column caption='Snapshot Dernier - Flux Real' datatype='integer' default-format='n#,##0;-#,##0' name='[Snapshot Dernier - Cadrage Real (copie)_1256785803706753040]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='count(IF [DateDujour] = {MAX([DateDujour])}  and [Statut flux]= &quot;Réalisation en cours&quot;&#13;&#10;THEN([Nom rapport]+[Nom source])&#13;&#10;END)' />
            </column>
            <column caption='Snapshot Précédent - Flux real' datatype='integer' default-format='n#,##0;-#,##0' name='[Snapshot Précédent - Conception Real (copie)_1256785803709407253]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='count(IF [DateDujour] = { FIXED : MAX(IF [DateDujour] &lt; {MAX([DateDujour])} THEN [DateDujour] END) } and [Statut flux]=&quot;Réalisation en cours&quot;&#13;&#10;THEN [Nom rapport]+[Nom source]&#13;&#10;END)' />
            </column>
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[Statut Cadrage conception]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[Statut flux]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[Statut reporting]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
