  <aliases enabled='yes' />
  <column aggregation='Sum' datatype='integer' default-type='quantitative' name='[Number of Records]' pivot='key' role='measure' type='quantitative' user-datatype='integer' user:auto-column='numrec' visual-totals='Default'>
    <calculation class='tableau' formula='1' />
  </column>
  <column aggregation='Count' caption='Extract' datatype='table' default-type='quantitative' name='[__tableau_internal_object_id__].[Extract_8511EF14388A4884986AA34C37CA5656]' pivot='key' role='measure' type='quantitative' user-datatype='table' visual-totals='Default' />
  <column caption='Domaine' datatype='string' name='[Domaine]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='IF STARTSWITH([Parent summary], &quot;NEX&quot;) THEN &quot;Nexus&quot; ELSEIF STARTSWITH([Parent summary], &quot;PLX&quot;) THEN &quot;Plexus&quot; ELSE &quot;Autres&quot; END' />
  </column>
  <column caption='Charge Jours' datatype='real' name='[Charge Jours]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='[Champs personnalisés (Story point estimate)] / [Param Ratio SP]' />
  </column>
  <column caption='Deadline Domaine' datatype='date' name='[Deadline Domaine]' role='dimension' type='ordinal'>
    <calculation class='tableau' formula='CASE [Domaine] WHEN &quot;Nexus&quot; THEN [Param Deadline Nexus] WHEN &quot;Plexus&quot; THEN [Param Deadline Plexus] ELSE [Param Deadline Autres] END' />
  </column>
  <column caption='Charge Realisee' datatype='real' name='[Charge Realisee]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='IF [État] = &quot;Terminé&quot; THEN [Charge Jours] ELSE 0 END' />
  </column>
  <column caption='Charge Restante' datatype='real' name='[Charge Restante]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='IF [État] &lt;&gt; &quot;Terminé&quot; THEN [Charge Jours] ELSE 0 END' />
  </column>
  <column caption='Mois Realisation' datatype='date' name='[Mois Realisation]' role='dimension' type='ordinal'>
    <calculation class='tableau' formula='DATETRUNC(&quot;month&quot;, [Résolu])' />
  </column>
  <column caption='Mois Planifie' datatype='date' name='[Mois Planifie]' role='dimension' type='ordinal'>
    <calculation class='tableau' formula='DATETRUNC(&quot;month&quot;, [Date d&apos;échéance])' />
  </column>
  <column caption='Statut Livraison' datatype='string' name='[Statut Livraison]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='IF { FIXED [Domaine] : SUM([Charge Restante])} = 0 THEN &quot;Livré&quot; ELSEIF TODAY() &gt; [Deadline Domaine] THEN &quot;Retard&quot; ELSE &quot;Dans délai&quot; END' />
  </column>
  <column caption='KPI Capacite Text' datatype='string' name='[KPI Capacite Text]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='STR([Param Capacite Dispo]) + &quot; j&quot;' />
