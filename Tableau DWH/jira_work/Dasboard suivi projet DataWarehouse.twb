      <map key='[Priorité]' value='[sqlproxy].[Priorité]' />
      <map key='[Rapporteur]' value='[sqlproxy].[Rapporteur]' />
      <map key='[Résolu]' value='[sqlproxy].[Résolu]' />
      <map key='[Résolution]' value='[sqlproxy].[Résolution]' />
