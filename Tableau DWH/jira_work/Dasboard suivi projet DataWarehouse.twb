      <column caption='Delta Cadrage Test' datatype='integer' default-format='n#,##0;-#,##0' name='[Delta Cadrage Real (copie)_1256785803699122177]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([Snapshot Dernier - Cadrage Real (copie)_1256785803705655306]) - &#13;&#10;ZN([Snapshot Précédent - Cadrage Real (copie) (copie) (copie)_1256785803705683983])' />
