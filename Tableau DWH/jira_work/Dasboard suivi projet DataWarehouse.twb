        <calculation class='tableau' formula='ZN([Snapshot Dernier - Cadrage Real (copie) (copie)_1256785803706773522]) - &#13;&#10;ZN([Snapshot Précédent - Conception Real (copie) (copie)_1256785803709419542])' />
