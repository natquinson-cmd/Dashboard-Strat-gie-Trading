    <worksheet name='Entonnoir %'>
      <table>
        <view>
          <datasources>
            <datasource caption='Perimetre_Migration_Hyper' name='sqlproxy.15pbedn0q6uqg31a9u9hr1vudrnj' />
          </datasources>
          <datasource-dependencies datasource='sqlproxy.15pbedn0q6uqg31a9u9hr1vudrnj'>
            <column caption='Scope à l&apos;étude' datatype='real' name='[Calculation_1009650768475484161]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Pertinence de reprise dans le cadre du projet] &lt;&gt; &quot;Non&quot; THEN 0.5 ELSE 0 END' />
            </column>
            <column caption='Full scope' datatype='real' name='[Calculation_1009650768598683663]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1/2' />
            </column>
            <column caption='Filtre - Date dernière extraction' datatype='boolean' name='[Calculation_1376412664187936768]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[DateDujour] = { FIXED : MAX([DateDujour]) }' />
            </column>
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[Cibles]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='Year' caption='Date Dujour' datatype='date' default-type='ordinal' layered='true' name='[DateDujour]' pivot='key' role='dimension' type='ordinal' user-datatype='date' visual-totals='Default' />
            <column caption='Full scope %' datatype='integer' default-format='p0%' name='[Full scope (copie)_1009650768602783763]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='min(1)' />
            </column>
            <column caption='Scope migration (avec Embedded)' datatype='real' name='[Nb rapports à migrer (copie)_1009650768516050951]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Pertinence de reprise dans le cadre du projet] = &quot;Oui&quot; THEN 0.5 ELSE 0 END' />
            </column>
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[Pertinence de reprise dans le cadre du projet]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[Projet]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column caption='Scope migration final % ' datatype='real' default-format='p0%' name='[Scope migration % (copie)_260364382993879047]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Scope migration (copie)_260364382988746753])/SUM([Calculation_1009650768598683663])' />
            </column>
            <column caption='Scope migration (avec Embedded)%' datatype='real' default-format='p0%' name='[Scope migration (copie)_1009650768601247762]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Nb rapports à migrer (copie)_1009650768516050951])/SUM([Calculation_1009650768598683663])' />
            </column>
            <column caption='Scope migration Final' datatype='real' name='[Scope migration (copie)_260364382988746753]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Pertinence de reprise dans le cadre du projet] = &quot;Oui&quot; AND ([Cibles]=&quot;BI&quot; OR [Cibles]=&quot;BI/Embedded&quot;) THEN 0.5 ELSE 0 END' />
            </column>
            <column caption='Scope à migrer %' datatype='real' default-format='p0%' name='[Scope à migrer (copie)_1009650768600842257]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_1009650768475484161])/sum([Calculation_1009650768598683663])' />
            </column>
            <column-instance column='[Calculation_1376412664187936768]' derivation='None' name='[none:Calculation_1376412664187936768:nk]' pivot='key' type='nominal' />
