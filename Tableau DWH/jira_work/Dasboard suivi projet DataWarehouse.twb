            <column caption='Snapshot Dernier - Reporting Test' datatype='integer' default-format='n#,##0;-#,##0' name='[Snapshot Dernier - Cadrage Test (copie) (copie)_1256785803706773523]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='count(IF [DateDujour] = {MAX([DateDujour])}  and [Statut reporting]= &quot;Tests en cours&quot;&#13;&#10;THEN([Nom rapport]+[Nom source])&#13;&#10;END)' />
