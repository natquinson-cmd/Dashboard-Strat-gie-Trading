          <calculation column='[Calculation_1256785803785252900]' formula='IF [Calculation_1009650768493371395] &lt;&gt; &quot;Terminé&quot; AND [Date d&apos;échéance] &lt; {MAX([DateDujour])} &#13;&#10;THEN &quot;Vrai&quot;&#13;&#10;ELSE &quot;Faux&quot;&#13;&#10;END' />
          <calculation column='[Calculation_1256785803787382821]' formula='{ FIXED [Nom source] : MAX(IF [Noms des champs de tableau croisé dynamique] = &quot;Ref Bi01&quot; THEN [Valeurs du champ de tableau croisé dynamique] END) }' />
