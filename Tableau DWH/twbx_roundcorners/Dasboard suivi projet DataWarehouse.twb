      <column aggregation='User' caption='% du delta Total Terminées' datatype='real' default-format='p0.0%' default-type='quantitative' layered='true' name='[% du Total Terminées (copie)_260364383334645788]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
        <calculation class='tableau' formula='(SUM([Calculation_260364383299268626]) - SUM([Calculation_260364383320588309])) &#13;&#10;/ &#13;&#10;SUM([Calculation_260364383320588309])' />
      </column>
      <column aggregation='Sum' caption='Scope à l&apos;étude' datatype='real' default-type='quantitative' layered='true' name='[Calculation_1009650768475484161]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
        <calculation class='tableau' formula='IF [Pertinence de reprise dans le cadre du projet] &lt;&gt; &quot;Non&quot; THEN 0.5 ELSE 0 END' />
      </column>
      <column aggregation='Count' caption='Statut Global' datatype='string' default-type='nominal' layered='true' name='[Calculation_1009650768493371395]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
        <calculation class='tableau' formula='IF [Statut reporting] = &quot;Terminé&quot; THEN &#13;&#10;    &quot;Terminé&quot;&#13;&#10;ELSEIF [Statut Cadrage conception] &lt;&gt; &quot;A faire&quot; THEN &#13;&#10;    &quot;En cours&quot;&#13;&#10;ELSE &#13;&#10;    &quot;A faire&quot;&#13;&#10;END' />
      </column>
      <column aggregation='Sum' caption='Full scope' datatype='real' default-type='quantitative' layered='true' name='[Calculation_1009650768598683663]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
        <calculation class='tableau' formula='1/2' />
      </column>
      <column aggregation='User' caption='Nb rapports total (non divisé)' datatype='integer' default-type='quantitative' layered='true' name='[Calculation_1009650768955822102]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
        <calculation class='tableau' formula='COUNT(IFNULL([Nom source], &quot;&quot;) + &quot; | &quot; + IFNULL([Nom rapport], &quot;&quot;))' />
      </column>
      <column aggregation='Count' caption='Filtre Tâche en retard' datatype='string' default-type='nominal' layered='true' name='[Calculation_1256785803785252900]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
        <calculation class='tableau' formula='IF [Calculation_1009650768493371395] &lt;&gt; &quot;Terminé&quot; AND [Date d&apos;échéance] &lt; {MAX([DateDujour])} &#13;&#10;THEN &quot;Vrai&quot;&#13;&#10;ELSE &quot;Faux&quot;&#13;&#10;END' />
      </column>
      <column aggregation='Count' caption='Intervenant 1' datatype='string' default-type='nominal' layered='true' name='[Calculation_1256785803787382821]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
        <calculation class='tableau' formula='{ FIXED [Nom source] : MAX(IF [Noms des champs de tableau croisé dynamique] = &quot;Ref Bi01&quot; THEN [Valeurs du champ de tableau croisé dynamique] END) }' />
      </column>
      <column aggregation='Count' caption='Filtre - Date dernière extraction' datatype='boolean' default-type='nominal' layered='true' name='[Calculation_1376412664187936768]' pivot='key' role='dimension' type='nominal' user-datatype='boolean' visual-totals='Default'>
        <calculation class='tableau' formula='[DateDujour] = { FIXED : MAX([DateDujour]) }' />
      </column>
      <column aggregation='User' caption='Nb rapports total' datatype='real' datatype-customized='true' default-format='n#,##0;-#,##0' default-type='quantitative' layered='true' name='[Calculation_1824239350087143424]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
        <calculation class='tableau' formula='COUNT(IFNULL([Nom source], &quot;&quot;) + &quot; | &quot; + IFNULL([Nom rapport], &quot;&quot;))/2' />
      </column>
      <column aggregation='Year' caption='Today' datatype='date' default-type='ordinal' layered='true' name='[Calculation_1912622497340284928]' pivot='key' role='dimension' type='ordinal' user-datatype='date' visual-totals='Default'>
        <calculation class='tableau' formula='TODAY()' />
      </column>
      <column aggregation='Year' caption='Min date selection' datatype='date' default-type='ordinal' layered='true' name='[Calculation_1912622497343381506]' pivot='key' role='dimension' type='ordinal' user-datatype='date' visual-totals='Default'>
        <calculation class='tableau' formula='{FIXED : MIN([DateDujour])}' />
      </column>
      <column aggregation='Count' caption='Filtre - Nouveau retard' datatype='string' default-type='nominal' layered='true' name='[Calculation_2104025483336175616]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
        <calculation class='tableau' formula='IF [DateDujour] = { FIXED : MAX([DateDujour]) }&#13;&#10;AND [Date d&apos;échéance] &lt; [DateDujour]&#13;&#10;AND [Date d&apos;échéance] &gt;= DATEADD(&apos;day&apos;, -7, [DateDujour])&#13;&#10;AND [Calculation_1009650768493371395] &lt;&gt; &quot;Terminé&quot;&#13;&#10;THEN &quot;Nouveau Retard&quot;&#13;&#10;ELSE &quot;Autre&quot;&#13;&#10;END' />
      </column>
      <column aggregation='User' caption='AVG(0)' datatype='real' default-type='quantitative' layered='true' name='[Calculation_260364383038353420]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
        <calculation class='tableau' formula='AVG(0)' />
      </column>
      <column aggregation='User' caption='AVG(0) (1)' datatype='real' default-type='quantitative' layered='true' name='[Calculation_260364383038431246]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
        <calculation class='tableau' formula='AVG(0)' />
      </column>
      <column aggregation='Sum' caption='Retard en jours' datatype='integer' default-type='quantitative' layered='true' name='[Calculation_260364383079702545]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [DateDujour], [Date d&apos;échéance])*-1' />
      </column>
      <column aggregation='Sum' caption='Tâches Terminées (Dernier Snapshot)' datatype='real' default-format='n#,##0;-#,##0' default-type='quantitative' layered='true' name='[Calculation_260364383299268626]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
        <calculation class='tableau' formula='IF [DateDujour] = {MAX([DateDujour])} &#13;&#10;THEN [Nb rapports (copie)_1824239350089158657] &#13;&#10;END' />
      </column>
      <column aggregation='User' caption='Delta rapports terminés' datatype='real' default-format='n#,##0;-#,##0' default-type='quantitative' layered='true' name='[Calculation_260364383300485140]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
        <calculation class='tableau' formula='ZN(sum([Calculation_260364383299268626])) - &#13;&#10;ZN(sum([Calculation_260364383320588309]))' />
      </column>
      <column aggregation='Sum' caption='Tâches Terminées (Snapshot Précédent)' datatype='real' default-format='n#,##0;-#,##0' default-type='quantitative' layered='true' name='[Calculation_260364383320588309]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
        <calculation class='tableau' formula='IF [DateDujour] = { FIXED : MAX(IF [DateDujour] &lt; {MAX([DateDujour])} THEN [DateDujour] END) }&#13;&#10;THEN [Calculation_2712292900835684352]&#13;&#10;END' />
      </column>
      <column aggregation='User' caption='Symbole Tendance Rapports terminés +' datatype='string' default-type='nominal' layered='true' name='[Calculation_260364383322931222]' pivot='key' role='measure' type='nominal' user-datatype='string' visual-totals='Default'>
        <calculation class='tableau' formula='IF [Calculation_260364383300485140] &gt; 0 THEN &quot;▲&quot;&#13;&#10;END' />
      </column>
      <column aggregation='Sum' caption='Nb Tâches en Retard' datatype='real' default-format='n#,##0;-#,##0' default-type='quantitative' layered='true' name='[Calculation_2628413362821959680]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
        <calculation class='tableau' formula='IF [Calculation_1009650768493371395] &lt;&gt; &quot;Terminé&quot; &#13;&#10;AND [Date d&apos;échéance] &lt; [DateDujour]&#13;&#10;THEN 0.5&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column aggregation='Sum' caption='Tâches Terminées' datatype='real' default-format='n#,##0;-#,##0' default-type='quantitative' layered='true' name='[Calculation_2712292900835684352]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
        <calculation class='tableau' formula='IF [Statut reporting] = &quot;Terminé&quot; THEN 0.5 ELSE 0 END' />
      </column>
      <column aggregation='Count' caption='Glossaire' datatype='string' default-type='nominal' layered='true' name='[Calculation_2841489928004562944]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
        <calculation class='tableau' formula='&quot;Tunnel de Migration&#13;&#10;Cette section mesure l&apos;entonnoir du périmètre projet, de l&apos;inventaire initial à la cible finale.&#13;&#10;&#13;&#10;Périmètre total : L&apos;inventaire complet des rapports identifiés au lancement de la migration (ex: 2 078 au total).&#13;&#10;&#13;&#10;Périmètre résiduel : Rapports dont la migration est confirmée et actuellement en cours d&apos;étude ou de traitement.&#13;&#10;&#13;&#10;Périmètre Reporting : Sous-ensemble des rapports destinés à être intégrés dans l&apos;environnement BI cible.&#13;&#10;&#13;&#10;Périmètre final : Nombre définitif de rapports qui seront maintenus en production après la bascule.&#13;&#10;&#13;&#10;📈 Avancement &amp; Statuts&#13;&#10;Indicateurs de performance temporelle et opérationnelle basés sur les snapshots de données.&#13;&#10;&#13;&#10;Statut (Cadrage, Conception, Flux, Reporting) : État d&apos;avancement par phase technique.&#13;&#10;&#13;&#10;A faire (Gris) : Tâches en attente.&#13;&#10;&#13;&#10;Analyse en cours (Orange) : Travail intellectuel ou technique entamé.&#13;&#10;&#13;&#10;Prêt pour réalisation (Jaune) : Étape validée prête pour le développement.&#13;&#10;&#13;&#10;Terminé (Vert) : Étape finalisée.&#13;&#10;&#13;&#10;Evolution S vs S-1 : Comparaison entre le snapshot actuel et le précédent.&#13;&#10;&#13;&#10;Real / Test : Indicateurs de performance réelle contre environnement de test.&#13;&#10;&#13;&#10;Calcul de Tendance : Utilise le formatage conditionnel discuté précédemment :&#13;&#10;&#13;&#10;▲ Rouge : Augmentation du volume de tâches (ou retard).&#13;&#10;&#13;&#10;▼ Vert : Diminution (progression positive).&#13;&#10;&#13;&#10;● Orange : Situation stable.&#13;&#10;&#13;&#10;⚖️ Workload &amp; Répartition&#13;&#10;Analyse de la charge de travail par flux et par intervenant.&#13;&#10;&#13;&#10;Workload par tâches (Donut Chart) : Répartition du volume de travail par code intervenant (NQU, ASA, EFR, JDF, etc.).&#13;&#10;&#13;&#10;Nexus / Plexus / Autres : Segmentation par pôles technologiques ou applicatifs du Data Warehouse.&#13;&#10;&#13;&#10;REF BI01 / REF BI02 (Champs calculés LOD) : Colonnes fixes permettant d&apos;identifier les intervenants référents sans être impactées par le pivot de données nécessaire aux graphiques de répartition.&#13;&#10;&#13;&#10;🕒 Alertes de Retard (Logique de filtre)&#13;&#10;Bien que non visible directement en texte, cette logique pilote vos indicateurs de tendance.&#13;&#10;&#13;&#10;Nouveau Retard : Tâche dont la date d&apos;échéance a été dépassée entre l&apos;avant-dernier et le dernier snapshot.&#13;&#10;&#13;&#10;Delta de Retard : Mesure mathématique (Écart = Snapshot actuel - Snapshot précédent) affichée avec les caractères spéciaux ▲/▼.&quot;' />
      </column>
      <column aggregation='User' caption='Filtre Top 10 Unique' datatype='integer' default-type='quantitative' layered='true' name='[Calculation_3581487649099849741]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
        <calculation class='tableau' formula='RANK_UNIQUE(SUM([Calculation_260364383079702545]), &apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
